NULLAFI_API_KEY=nul_dummy_1234567890abcdef
NULLAFI_NAMESPACE=dlp test
NULLAFI_BASE_URL=https://openflow.nullafi.net/api

# Optional. With the base URL above, this calls:
# https://openflow.nullafi.net/api/scan
NULLAFI_SCAN_PATH=/scan

# Optional activity-tracking params supported by Nullafi.
NULLAFI_USERNAME=local-poc
NULLAFI_USERGROUP=engineering

# Optional request timeout in seconds.
NULLAFI_TIMEOUT_SECONDS=15
